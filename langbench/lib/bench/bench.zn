package bench;

import core$;

/// The problem size the program was started with: its first argument, or
/// `fallback` when it has none or the first spells no integer.
Int size(runtime Runtime, fallback Int) {
	args List<String> = runtime:arguments();
	if(args:size() < 1) {
		return fallback;
	}
	return args[Int(1)]:parseInt() ?? fallback;
}

/// 2 to the power `exponent`.
Int power(exponent Int) {
	result Int = Int(1);
	i Int = Int(1);
	i!to(exponent) {
		result = result * 2;
	}
	return result;
}
