package bench;

import core$;
import math$;

/// The problem size the program was started with: its first argument, or
/// `fallback` when it has none or the first spells no integer.
Int size(runtime Runtime, fallback Int) {
	args List<String> = runtime:arguments();
	if(args:size() < 1) {
		return fallback;
	}
	return args[Int(1)]:parseInt() ?? fallback;
}

/// 2 to the power `exponent`.
Int power(exponent Int) {
	result Int = Int(1);
	i Int = Int(1);
	i!to(exponent) {
		result = result * 2;
	}
	return result;
}

/// A linear congruential generator that every language in the bench steps
/// the same way, so all of them draw the same numbers.
type Rng = struct {
	state Int;
}

Rng(seed Int) => init{
	state = seed;
}

/// The next number, from 0 to 2^31 - 1.
Int next(this Rng) mut {
	this.state = bitAnd(this.state * 1103515245 + 12345, Int(2147483647));
	return this.state;
}

/// A number from 0 to `bound` - 1.
Int below(this Rng, bound Int) mut {
	k Int = this!next();
	return k - k / bound * bound;
}
